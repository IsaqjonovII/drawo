{
  "format": "dsai",
  "version": "1.0",
  "name": "drawo-ui",
  "modes": {
    "theme": ["light", "dark"]
  },
  "tokens": {
    "font": {
      "type": "font",
      "value": "Inter"
    },
    "canvas": {
      "type": "color",
      "value": "#F2F3F5",
      "modes": {
        "theme:dark": "#0D0E11"
      }
    },
    "grid": {
      "type": "color",
      "value": "#E6E8EC",
      "modes": {
        "theme:dark": "#1E2024"
      }
    },
    "panel": {
