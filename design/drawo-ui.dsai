      "value": "#FFFFFF",
      "modes": {
        "theme:dark": "#191A1D"
      }
    },
    "fg": {
      "type": "color",
      "value": "#15171C",
      "modes": {
        "theme:dark": "#EDEEF0"
      }
    },
    "muted": {
      "type": "color",
      "value": "#5E636C",
      "modes": {
        "theme:dark": "#A7ADB7"
      }
    },
    "border": {
